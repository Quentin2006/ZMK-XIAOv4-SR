#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
    &kp ESC             &kp N1              &kp N2              &kp N3              &kp N4              &kp N5                &kp N6              &kp N7              &kp N8              &kp N9              &kp N0              &kp EQUAL
    &kp TAB             &kp Q               &kp W               &kp E               &kp R               &kp T                 &kp Y               &kp U               &kp I               &kp O               &kp P               &kp MINUS
    &kp LSHFT           &kp A               &kp S               &kp D               &kp F               &kp G                 &kp H               &kp J               &kp K               &kp L               &kp SEMI            &kp SQT
    &kp GRAVE           &kp Z               &kp X               &kp C               &kp V               &kp B                 &kp N               &kp M               &kp COMMA           &kp DOT             &kp FSLH            &kp BSLH
    &mkp LCLK  &mkp RCLK  &mkp MCLK  &tog 4
    &kp LSHFT  &kp SPACE  &kp BSPC  &kp RGUI
    &kp LALT  &kp LCTRL  &mo 1  &kp LALT  &kp RET  &kp DEL
            >;
        };

        layer_1 {
            bindings = <
    &trans              &kp F1              &kp F2              &kp F3              &kp F4              &kp F5                &kp F6              &kp F7              &kp F8              &kp F9              &kp F10             &kp F12
    &trans              &trans              &trans              &trans              &trans              &trans                &trans              &trans              &trans              &trans              &trans              &kp F11
    &trans              &trans              &trans              &trans              &trans              &trans                &kp LEFT            &kp DOWN            &kp UP              &kp RIGHT           &trans              &trans
    &trans              &trans              &trans              &trans              &trans              &trans                &kp C_PLAY_PAUSE    &kp C_MUTE          &kp C_VOL_DN        &kp C_VOL_UP        &trans              &trans
    &kp HOME  &kp END  &kp PG_UP  &kp PG_DN
    &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
    &rgb_ug RGB_TOG     &rgb_ug RGB_EFF     &bt BT_CLR          &bt BT_NXT          &trans              &trans                &trans              &trans              &trans              &trans              &trans              &trans
    &trans              &trans              &trans              &trans              &trans              &trans                &trans              &trans              &trans              &trans              &trans              &trans
    &trans              &trans              &trans              &trans              &trans              &trans                &trans              &trans              &trans              &trans              &trans              &trans
    &trans              &trans              &trans              &trans              &trans              &trans                &trans              &trans              &trans              &trans              &trans              &trans
    &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &bootloader
    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // Auto-mouse layer: activated by trackball motion; timeout is in skreecustom.dtsi.

        layer_3 {
            bindings = <
    &trans              &trans              &trans              &trans              &trans              &trans                &trans              &trans              &trans              &trans              &trans              &trans
    &trans              &trans              &trans              &trans              &trans              &trans                &trans              &trans              &trans              &trans              &trans              &trans
    &trans              &trans              &trans              &trans              &trans              &trans                &trans              &trans              &trans              &trans              &trans              &trans
    &trans              &trans              &trans              &trans              &trans              &trans                &trans              &trans              &trans              &trans              &trans              &trans
    &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans
    &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans
            >;
        };

        // Scroll mode: enabled by &tog 4; the trackball listener maps motion to scroll.
        layer_4 {
            bindings = <
    &trans              &trans              &trans              &trans              &trans              &trans                &trans              &trans              &trans              &trans              &trans              &trans
    &trans              &trans              &trans              &trans              &trans              &trans                &trans              &trans              &trans              &trans              &trans              &trans
    &trans              &trans              &trans              &trans              &trans              &trans                &trans              &trans              &trans              &trans              &trans              &trans
    &trans              &trans              &trans              &trans              &trans              &trans                &trans              &trans              &trans              &trans              &trans              &trans
    &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};

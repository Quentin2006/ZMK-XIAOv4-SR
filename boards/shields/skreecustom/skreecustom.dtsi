#include <dt-bindings/zmk/matrix_transform.h>

 / {
     chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };


     // Left half = cols 0-5, right half = cols 6-11 (col-offset 6).
     // Row 5 is the thumb row (1.15); 1.11 is not scanned.
     default_transform: keymap_transform_0 {
         compatible = "zmk,matrix-transform";
         columns = <12>;
         rows = <6>;

         map = <
    RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)		    RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
    RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)		    RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
    RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)		    RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
    RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)		    RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
                    RC(4,2) RC(4,3)                                         RC(4,8) RC(4,9)

			                RC(5,0) RC(5,1) RC(5,2) 	                    RC(5,9)
			                RC(5,3) RC(5,4) RC(5,5) 	    RC(5,8) RC(5,7) RC(5,6)
         >;
     };

     kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        row-gpios
             = <&gpio0 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> //r1-6 0.03 0.28 1.01 0.09 0.10 1.15thumbs
            , <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            //, <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

        col-gpios           // Col1-7 1.07 1.14 1.05 1.13 1.03 1.12 0.16 (same on both halves)
            = <&gpio1 7 GPIO_ACTIVE_HIGH>
            , <&gpio1 14 GPIO_ACTIVE_HIGH>
            , <&gpio1 5 GPIO_ACTIVE_HIGH>
            , <&gpio1 13 GPIO_ACTIVE_HIGH>
            , <&gpio1 3 GPIO_ACTIVE_HIGH>
            , <&gpio1 12 GPIO_ACTIVE_HIGH>
//          , <&gpio0 16 GPIO_ACTIVE_HIGH>
            ;
    };

//right hand trackball -> sent to the left (central) over the split link
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackball_split: trackball_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    // Enabled on the left (central) only. Axis orientation is handled by the
    // sensor itself (swap-xy / invert-x / invert-y in skreecustom_right.overlay).
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&trackball_split>;
    };
};
